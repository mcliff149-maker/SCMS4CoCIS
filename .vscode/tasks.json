{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SCMS: PlatformIO build",
      "type": "shell",
      "command": "pio run -e esp32dev",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$gcc"],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "SCMS: configure host tests",
      "type": "shell",
      "command": "cmake -S tests -B build/host",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "SCMS: build host tests",
      "type": "shell",
      "command": "cmake --build build/host",
      "dependsOn": "SCMS: configure host tests",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "SCMS: test",
      "type": "shell",
      "command": "ctest --test-dir build/host --output-on-failure",
      "dependsOn": "SCMS: build host tests",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": "test"
    }
  ]
}
