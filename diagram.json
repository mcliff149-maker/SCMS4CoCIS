  "parts": [
    { "type": "wokwi-text", "id": "title", "top": -90, "left": 0, "attrs": { "text": "CoCIS SMART CONTROL SYSTEM - ONE ESP32, TWO INPUT REGISTERS\nRFID identifies the person. Custom sensor controls simulate walking through.\nApplication firmware is separate; this diagram alone does not operate the system." } },
    { "type": "wokwi-text", "id": "entry_label", "top": 0, "left": 0, "attrs": { "text": "CHECKPOINT 1 - BUILDING ENTRY\nRFID CS 4 | Servo 25 | Sensor U1 D0/D1" } },
    { "type": "wokwi-text", "id": "cp2_label", "top": 0, "left": 430, "attrs": { "text": "CHECKPOINT 2 - INTERNAL FAST PASS\nRFID CS 13 | Servo 26 | Sensor U1 D2/D3" } },
    { "type": "wokwi-text", "id": "exit_label", "top": 0, "left": 860, "attrs": { "text": "BUILDING EXIT\nRFID CS 14 | Servo 27 | Sensor U1 D4/D5" } },
    { "type": "board-mfrc522", "id": "rfid_entry", "top": 60, "left": 0, "attrs": {} },
    { "type": "board-mfrc522", "id": "rfid_cp2", "top": 60, "left": 430, "attrs": {} },
    { "type": "board-mfrc522", "id": "rfid_exit", "top": 60, "left": 860, "attrs": {} },
    { "type": "wokwi-servo", "id": "servo_entry", "top": 250, "left": 0, "attrs": {} },
    { "type": "wokwi-servo", "id": "servo_cp2", "top": 250, "left": 430, "attrs": {} },
    { "type": "wokwi-servo", "id": "servo_exit", "top": 250, "left": 860, "attrs": {} },
    { "type": "chip-passage", "id": "pass_entry", "top": 270, "left": 190, "attrs": { "direction": "0", "trigger": "0" } },
    { "type": "chip-passage", "id": "pass_cp2", "top": 270, "left": 620, "attrs": { "direction": "0", "trigger": "0" } },
    { "type": "chip-passage", "id": "pass_exit", "top": 270, "left": 1050, "attrs": { "direction": "0", "trigger": "0" } },
    { "type": "wokwi-slide-switch", "id": "door_entry", "top": 380, "left": 40, "attrs": { "bounce": "0" } },
    { "type": "wokwi-slide-switch", "id": "door_cp2", "top": 380, "left": 470, "attrs": { "bounce": "0" } },
    { "type": "wokwi-slide-switch", "id": "door_exit", "top": 380, "left": 900, "attrs": { "bounce": "0" } },
    { "type": "wokwi-text", "id": "door_note", "top": 435, "left": 0, "attrs": { "text": "Door switches: LEFT closed, RIGHT open. Operate manually; they do not follow the servos.\nFor each passage chip: direction 0 = A then B; direction 1 = B then A. Toggle trigger to simulate ONE crossing.\nAt EXIT, A then B means outward; at checkpoints and rooms it means inward." } },
    { "type": "wokwi-text", "id": "dashboard_label", "top": 0, "left": 1300, "attrs": { "text": "CENTRAL LCD + TWO MENU BUTTONS\nSDA 21 | SCL 22 | LCD 0x27 | RTC 0x68" } },
    { "type": "wokwi-lcd2004", "id": "lcd", "top": 60, "left": 1300, "attrs": { "pins": "i2c", "i2cAddress": "0x27" } },
    { "type": "wokwi-pushbutton", "id": "next", "top": 250, "left": 1320, "attrs": { "color": "blue", "label": "NEXT [N]", "key": "n", "bounce": "0" } },
    { "type": "wokwi-pushbutton", "id": "select", "top": 250, "left": 1460, "attrs": { "color": "green", "label": "SELECT / HOLD BACK [S]", "key": "s", "bounce": "0" } },
    { "type": "wokwi-resistor", "id": "r_next", "top": 330, "left": 1320, "attrs": { "value": "10000" } },
    { "type": "wokwi-resistor", "id": "r_select", "top": 330, "left": 1460, "attrs": { "value": "10000" } },
    { "type": "wokwi-microsd-card", "id": "sd", "top": 390, "left": 1300, "attrs": {} },
    { "type": "wokwi-ds1307", "id": "rtc", "top": 390, "left": 1530, "attrs": { "initTime": "now" } },
    { "type": "wokwi-text", "id": "room1_label", "top": 530, "left": 0, "attrs": { "text": "LECTURE ROOM 1\nDirectional passage + PIR + relay-controlled light" } },
    { "type": "wokwi-text", "id": "room2_label", "top": 530, "left": 470, "attrs": { "text": "LECTURE ROOM 2\nDirectional passage + PIR + relay-controlled light" } },
    { "type": "chip-passage", "id": "pass_room1", "top": 600, "left": 0, "attrs": { "direction": "0", "trigger": "0" } },
    { "type": "chip-passage", "id": "pass_room2", "top": 600, "left": 470, "attrs": { "direction": "0", "trigger": "0" } },
