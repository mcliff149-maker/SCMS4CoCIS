    { "type": "wokwi-esp32-devkit-v1", "id": "esp", "top": 600, "left": 970, "attrs": {} },
    { "type": "wokwi-text", "id": "emergency_label", "top": 530, "left": 1300, "attrs": { "text": "EMERGENCY + SIMULATED FIRE SIGNAL\nLEFT normal / RIGHT alarm\nEmergency GPIO 39 is active LOW; fire input is active HIGH." } },
    { "type": "wokwi-slide-switch", "id": "emergency", "top": 620, "left": 1320, "attrs": { "bounce": "0" } },
    { "type": "wokwi-slide-switch", "id": "fire", "top": 620, "left": 1510, "attrs": { "bounce": "0" } },
    { "type": "wokwi-resistor", "id": "r_emergency", "top": 690, "left": 1320, "attrs": { "value": "10000" } },
    { "type": "wokwi-neopixel", "id": "status", "top": 780, "left": 1320, "attrs": {} },
    { "type": "wokwi-resistor", "id": "r_status", "top": 850, "left": 1320, "attrs": { "value": "330" } },
    { "type": "wokwi-resistor", "id": "r_status_bias", "top": 900, "left": 1320, "attrs": { "value": "10000" } },
    { "type": "wokwi-buzzer", "id": "buzzer", "top": 780, "left": 1510, "attrs": { "volume": "0.15" } },
    { "type": "wokwi-text", "id": "status_note", "top": 950, "left": 1300, "attrs": { "text": "One addressable RGB status LED: GPIO 2\nGreen: grant | Red: deny | Flashing red: emergency\nThese patterns require application firmware." } },
    { "type": "wokwi-text", "id": "u1_label", "top": 950, "left": 0, "attrs": { "text": "U1: CP1 A/B, CP2 A/B, EXIT A/B, ROOM 1 A/B" } },
    { "type": "wokwi-text", "id": "u2_label", "top": 950, "left": 530, "attrs": { "text": "U2: ROOM 2 A/B, THREE DOORS, FIRE, NEXT, SELECT" } },
    { "type": "wokwi-74hc165", "id": "u1", "top": 1030, "left": 70, "attrs": {} },
    { "type": "wokwi-74hc165", "id": "u2", "top": 1030, "left": 600, "attrs": {} },
    { "type": "wokwi-text", "id": "chain_note", "top": 1170, "left": 0, "attrs": { "text": "TWO INPUT REGISTERS ONLY: U2 Q7 -> U1 DS; U1 Q7 -> GPIO 36 (VP)\nCP -> GPIO 17 (TX2); PL -> GPIO 33; CE -> GND; U2 DS -> GND.\nRelays connect directly to GPIO 16 (RX2) and GPIO 15. No output register or keypad.\nPower/ground and bias wires are hidden for clarity but are electrically connected.\nSimulation prototype only: no independent physical emergency release is represented." } },
    { "type": "wokwi-text", "id": "bias_label", "top": 0, "left": 1820, "attrs": { "text": "BIAS RESISTORS\n10k pull-ups: four CS, two relay inputs, input PL\n4.7k pull-ups: SDA / SCL\n10k pull-down: input clock" } },
    { "type": "wokwi-resistor", "id": "r_cs1", "top": 160, "left": 1820, "attrs": { "value": "10000" } },
    { "type": "wokwi-resistor", "id": "r_cs2", "top": 220, "left": 1820, "attrs": { "value": "10000" } },
    { "type": "wokwi-resistor", "id": "r_cs3", "top": 280, "left": 1820, "attrs": { "value": "10000" } },
    { "type": "wokwi-resistor", "id": "r_cs_sd", "top": 340, "left": 1820, "attrs": { "value": "10000" } },
    { "type": "wokwi-resistor", "id": "r_sda", "top": 400, "left": 1820, "attrs": { "value": "4700" } },
    { "type": "wokwi-resistor", "id": "r_scl", "top": 460, "left": 1820, "attrs": { "value": "4700" } },
    { "type": "wokwi-resistor", "id": "r_relay1", "top": 520, "left": 1820, "attrs": { "value": "10000" } },
    { "type": "wokwi-resistor", "id": "r_relay2", "top": 580, "left": 1820, "attrs": { "value": "10000" } },
    { "type": "wokwi-resistor", "id": "r_load", "top": 640, "left": 1820, "attrs": { "value": "10000" } },
    { "type": "wokwi-resistor", "id": "r_clock", "top": 700, "left": 1820, "attrs": { "value": "10000" } }
  ],
